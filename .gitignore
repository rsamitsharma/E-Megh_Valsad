# E-Megh Git Ignore Rules

# Dependency directories (Node.js)
**/node_modules/
node_modules/
E-Megh_Api/node_modules/ 
E-Megh_FrontEnd/node_modules/

E-Megh_FrontEnd/dist/ 
E-Megh_FrontEnd/E-Megh/dist/

# Angular cache and build directories
**/.angular/
.angular/
dist/
**/dist/
**/dist.zip

# Python cache and temporary files (for prediction APIs)
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Large Machine Learning model files (to prevent pushing heavy binary files)
*.pkl
E-Megh_Api/*.pkl

# Local environment and secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
E-Megh_Api/.env

# IDE / Editor configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
Thumbs.db
db.sqlite3
.DS_Store
